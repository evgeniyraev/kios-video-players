{
  "name": "simpleplayer",
  "version": "2.4.0",
  "description": "Simple fullscreen video playlist player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.simpleplayer.app",
    "productName": "SimplePlayer",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "settings/**/*",
      "server/**/*"
    ],
    "asarUnpack": [
      "server/public/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "evgeniyraev",
        "repo": "kios-video-players"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
